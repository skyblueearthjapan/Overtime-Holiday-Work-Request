# 見本（実装仕様 1-1）。VPS では /opt/overtime/.env を作り（chmod 600）、値を入れる。.env は git に入れない。
# 必須の値が欠けている・危ない組み合わせのときは api と worker は起動しない（fail-closed）。
# 秘密の値はここに書かず CHANGE_ME だけ置く。手元の控えは C:\Users\imaizumi.LINEWORKS-NET\.secrets\overtime\。

# staging（切り替えまで）| production（切り替えの日に、オーナーの許可を得てからディレクターが変える）
APP_ENV=staging
PUBLIC_ORIGIN=https://overtime.lineworks-local.net
# 出す版のタグ（手元で git rev-parse --short HEAD）。コマンド行ではなくここに書く（罠 24e）
APP_IMAGE_TAG=latest

# DB（db コンテナの中だけで使う。DATABASE_URL は compose がこの 3 つから作る）
POSTGRES_USER=overtime
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=overtime

# Google ログイン（GCP sebastian01 の「Overtime Holiday Work Request (VPS)」）
# 承認済みのリダイレクト URI:
#   https://overtime.lineworks-local.net/auth/callback
#   https://overtime.lineworks-local.net/auth/google-delegate/callback
GOOGLE_OAUTH_CLIENT_ID=CHANGE_ME.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=CHANGE_ME
ALLOWED_DOMAIN=lineworks-local.info

# セッションの署名鍵（32 文字以上の乱数）: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME
# ログインの持ち時間（9-1 #24: 90 日。無操作でも 90 日は切らない）
SESSION_MAX_AGE_DAYS=90
SESSION_IDLE_HOURS=2160

# 管理者（Settings の ADMIN_EMAILS・GENERAL_AFFAIRS_EMAILS に足す）。委任の開始もこの人だけ。空なら起動しない
BOOTSTRAP_ADMINS=imaizumi@lineworks-local.info

# 委任トークン（スプレッドシート・ドライブ）を暗号化する鍵
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# 鍵を変えると保存済みのトークンが読めなくなる（/auth/google-delegate/start から許可し直す）
FERNET_KEY=CHANGE_ME
# GAS の持ち主（委任の持ち主）
DELEGATE_EMAIL=imaizumi@lineworks-local.info

# ===== 業務用の ID と安全装置（読むのは app/config.py だけ。本番の ID はコードの定数と違えば起動しない） =====
# 本番 DB スプレッドシート（PDF テンプレも同じ）
PROD_SPREADSHEET_ID=1Knx_kaQMZZams65J1oeSDaBeWUt8XXanNe94XSAHKFQ
# ステージングの DB（本番 DB の「コピーを作成」で作ったサンドボックス）。staging で必須。本番と同じなら起動しない
STAGING_SPREADSHEET_ID=1I0dPlH6w14UaiJVbO9i6wFCXlvGyPEJvDus8ekGptWY
# マスタ元（SOURCE_SSID。読むだけ）
MASTER_SOURCE_SPREADSHEET_ID=1iu5HoaknlW1W1HheeYv0jqcRq-aY0SyEE2seQd2pHkQ
# PDF フォルダ（VPS は書かない。internal.ping の照合だけ）。staging では両方必須で、同じなら起動しない
PROD_PDF_FOLDER_ID=1Bs1FvgRvlCAkpARZ0XN3YkXJS9eoIN1B
STAGING_PDF_FOLDER_ID=1KsWanVEQr-gMsb_N9mxzplEjKFibsnrc
# 蓄積台帳（VPS は書かない。GAS が書く）。staging は台帳のコピー
PROD_LEDGER_SPREADSHEET_ID=1tKlT57SJxJijgfDVGafZ434sdVjscJJqN2uQ7P3sUyU
STAGING_LEDGER_SPREADSHEET_ID=16M5PxyozS_tTEpQmR6jizICgZov4SoK2M1IO4TG1oHI

# ===== GAS の内部用の入口（実装仕様 7-1） =====
# 内部用のデプロイの /exec（https://script.google.com/macros/s/<deploymentId>/exec の形）。
# staging はステージングの GAS の写しのデプロイ（例: AKfycbw9uPC4C5zlY5S3YqR9Yo0TECZETvUUgGY2ih447eL8E8XS0_VhVpwtftinTr4Nj5A）。
# 本番の GAS のデプロイ（AKfycbwHnaECeni3FmmgtVzBZIM_xDMH3bw9Qx5sQMrW9J3XoRCOs_RmdyBensZX5Xta6sfIxA など）を staging に書くと起動しない
GAS_INTERNAL_URL=https://script.google.com/macros/s/CHANGE_ME/exec
# GAS のスクリプトのプロパティ VPS_INTERNAL_TOKEN と同じ値（32 バイト以上の乱数。staging と本番で別の値）
GAS_INTERNAL_TOKEN=CHANGE_ME
GAS_CALL_TIMEOUT_SECONDS=330
# 本番の内部用の GAS のデプロイの deploymentId（AKfyc…）。作ったら staging・本番の両方の .env に同じ値を書く。
# production: GAS_INTERNAL_URL がこのデプロイでなければ起動しない。staging: GAS_INTERNAL_URL がこれなら起動しない。
# 空なら未設定（切り替えの前提条件。docs/cutover-runbook.md）
PROD_GAS_INTERNAL_DEPLOYMENT_ID=

# ===== Sebastian の入口（POST /api/sebastian） =====
# GAS のスクリプトのプロパティ SEBASTIAN_API_TOKEN の値を写す（32 字以上でなければ起動しない。GAS_INTERNAL_TOKEN と同じ値も不可。
# 今の値が短ければ、Hermès（Sebastian）側と一緒に 32 字以上の乱数へ入れ替える）
SEBASTIAN_API_TOKEN=CHANGE_ME
# GAS の転送（UrlFetchApp）の待ち時間より短く（スパイクで直す）
SEBASTIAN_PDF_WAIT_SECONDS=40

# DB スプレッドシートの時間帯（IANA 名。スパイクで「ファイル → 設定」と Sheets API の properties.timeZone を読んで決める）。
# シートの値と違えば行の反映を止める（gap-5 高-2）
DB_SHEET_TIMEZONE=Asia/Tokyo
# 社内ポータルの固定 URL（src/adminApi.gs:554 の値をそのまま写す）
PORTAL_URL=https://script.google.com/a/macros/lineworks-local.info/s/AKfycbx2eyJMOYP9o--GPBuhY-pj071IIR6Kqb_0xALwwNzdLQZux0dIAlL3P9EoCucnzXA/exec
# 共有タブ（Settings・DeptApprovers・ApproverMap）の取り込みの間隔（分）
SHEET_CONFIG_SYNC_MINUTES=5
# シートへ書く前の関所: 合格した gas_ping（本番は GAS の migrated=true も必要）がこの分数より古ければ、
# 行の反映・照合・マスタ同期はシートへ書かない（管理者の欄の sheetWriteGate に理由が出る）
SHEET_WRITE_PING_MAX_MINUTES=10

# uvicorn が X-Forwarded-* を信じる相手（web コンテナの固定 IP）
FORWARDED_ALLOW_IPS=10.93.0.10

# Cloudflare Tunnel（overtime-vps）のトークン。転送先は http://web:80
TUNNEL_TOKEN=CHANGE_ME

# バックアップ（overtime_*.dump。毎日 3 時。1KB 未満は FAILED）
BACKUPS_HOST_PATH=./backups
BACKUP_KEEP_DAYS=14

# docker のネットワーク（web の IP を固定し、api はその IP からの X-Forwarded-For だけを信じる）
# 変えたら docker compose down → up
OVERTIME_NET_SUBNET=10.93.0.0/24
OVERTIME_WEB_IP=10.93.0.10
